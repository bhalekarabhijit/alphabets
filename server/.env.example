# Alphabets API Keys
# Get your free OpenRouter API key at: https://openrouter.ai/
# Uses DeepSeek Chat V3.1 (free tier)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# GitHub PAT for the one-click "Refresh forecasts" button (optional).
# Create at github.com/settings/tokens?type=beta -> fine-grained PAT,
# repository access: only bhalekarabhijit/alphabets, permissions: Actions read+write.
# Without this, the button shows setup instructions; nightly runs still work.
GH_PAT=
# Override if the repo ever moves. Workflow file name is fixed.
# GH_REPO=bhalekarabhijit/alphabets

# Server Configuration
PORT=3001
